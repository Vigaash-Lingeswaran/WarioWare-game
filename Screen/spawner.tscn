[gd_scene format=3 uid="uid://go3haeet8edu"]

[sub_resource type="GDScript" id="GDScript_14tkw"]
script/source = "extends Node2D

var item_scene = preload(\"res://Screen/falling_garlic.tscn\")


func _on_spawn_timer_timeout() -> void:
	var item = item_scene.instantiate()
	var random_x = randf_range(50, 1100)
	item.position = Vector2(random_x, -50)
	get_tree().current_scene.add_child(item)"

[node name="Spawner" type="Node2D" unique_id=1044978649]
script = SubResource("GDScript_14tkw")

[node name="Spawn Timer" type="Timer" parent="." unique_id=117253917]
wait_time = 0.5
autostart = true

[connection signal="timeout" from="Spawn Timer" to="." method="_on_spawn_timer_timeout"]
